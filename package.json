{
  "name": "maruti-800-automotive-diary",
  "description": "Desktop application for maintaining an automotive diary, engineering encyclopedia, and service planner for a Maruti 800.",
  "author": "Maruti 800 Project",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 4173 --strictPort\" \"wait-on http://localhost:4173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "electron": "^31.7.1",
    "electron-builder": "^24.13.0",
    "vite": "^5.4.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.maruti800.automotiveDiary",
    "productName": "Maruti 800 Automotive Diary",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "signAndEditExecutable": false
    }
  }
}
